# CourseFlow Environment Variables Template
# Copy this file to .env and configure your credentials

# ==============================================================================
# 1. Hosted Relational Database Configuration (PostgreSQL / Supabase)
# ==============================================================================
# To connect to Supabase:
# 1. Create a free project at https://supabase.com
# 2. Go to Project Settings -> Database -> Connection string -> URI
# 3. Paste the connection string below (replace [YOUR-PASSWORD] with your database password):
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Note: If DATABASE_URL is left blank, CourseFlow automatically uses the local
# persistent SQLite database (courseflow.db) so the app remains fully functional offline.

# ==============================================================================
# 2. Flask Application Security
# ==============================================================================
SECRET_KEY=courseflow-cfms-dev-secret-key-2024

# ==============================================================================
# 3. Google Gemini AI Configuration (Course Handout Summarizer)
# ==============================================================================
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
